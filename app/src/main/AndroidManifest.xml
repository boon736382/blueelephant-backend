<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pongsawad.blueelephant">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Blueelephant">

        <!-- Launcher activity -->
        <activity
            android:name=".ui.theme.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Other activities -->
        <activity android:name=".ui.theme.FriendActivity" />
        <activity android:name=".ui.theme.MainChatActivity"/>
        <activity android:name=".LoginActivity"/>
        <activity android:name=".RegisterActivity"/>
        <activity android:name=".ui.theme.OnboardingActivity"/>
        <activity android:name=".ChatRoomActivity" />


    </application>
</manifest>
